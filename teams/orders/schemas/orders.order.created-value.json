{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderCreated",
  "description": "A customer placed an order.",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "customerId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPriceMinor": { "type": "integer" }
        },
        "required": ["sku", "quantity", "unitPriceMinor"]
      }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
  },
  "required": ["orderId", "customerId", "createdAt", "lines", "currency"]
}
